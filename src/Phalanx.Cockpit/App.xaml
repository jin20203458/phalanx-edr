<Application
    x:Class="Phalanx.Cockpit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active Theme Palette (Index 0: Swapped dynamically by ThemeManager) -->
                <ResourceDictionary Source="pack://application:,,,/Phalanx.Cockpit;component/Themes/Palettes/DarkPalette.xaml" />
                <!-- Permanent Component Styles & ControlTemplates (Index 1) -->
                <ResourceDictionary Source="pack://application:,,,/Phalanx.Cockpit;component/Themes/EnterpriseTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
