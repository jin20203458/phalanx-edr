<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- ================================================================= -->
    <!--  1. Enterprise Obsidian Dark Palette (Pure Neutral Dark - No Navy) -->
    <!-- ================================================================= -->
    <SolidColorBrush x:Key="RootBackgroundBrush" Color="#0E0E0E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141414" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#222222" />
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#282828" />
    <SolidColorBrush x:Key="BorderBrush" Color="#262626" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#333333" />
    <SolidColorBrush x:Key="BorderFocusedBrush" Color="#4A4A4A" />

    <!-- Typography Brushes (Obsidian Neutral Zinc Hierarchy) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#52525B" />

    <!-- Semantic Severity Brushes (Restrained Enterprise Tones) -->
    <SolidColorBrush x:Key="SeverityCriticalBgBrush" Color="#261315" />
    <SolidColorBrush x:Key="SeverityCriticalBorderBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="SeverityCriticalTextBrush" Color="#F87171" />

    <SolidColorBrush x:Key="SeverityBenignBgBrush" Color="#112017" />
    <SolidColorBrush x:Key="SeverityBenignBorderBrush" Color="#166534" />
    <SolidColorBrush x:Key="SeverityBenignTextBrush" Color="#4ADE80" />

    <SolidColorBrush x:Key="SeveritySuspendedBgBrush" Color="#241C10" />
    <SolidColorBrush x:Key="SeveritySuspendedBorderBrush" Color="#92400E" />
    <SolidColorBrush x:Key="SeveritySuspendedTextBrush" Color="#FBBF24" />

    <!-- Option A: Micro-Dot & Monochromatic Badge Palette (Linear / SentinelOne Style) -->
    <SolidColorBrush x:Key="BadgeBgBrush" Color="#181818" />
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="DotCriticalBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="DotSuspendedBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DotBenignBrush" Color="#71717A" />
    <SolidColorBrush x:Key="DotLiveBrush" Color="#10B981" />

    <!-- Brand & Accent Brushes (Refined Titanium / Platinum Steel) -->
    <SolidColorBrush x:Key="AccentBrandBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="AccentBrandHoverBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#FFFFFF" />

    <!-- ================================================================= -->
    <!--  2. Vector Icon Geometries (SVG Path Data - No Decorative Emojis)  -->
    <!-- ================================================================= -->
    <!-- Phalanx Minimalist Layered Chevron Shield (Triple Defense Plates) -->
    <Geometry x:Key="IconShield">M 12,2 L 20,5.5 L 20,8 L 12,4.5 L 4,8 L 4,5.5 Z M 12,7 L 20,10.5 L 20,13 L 12,9.5 L 4,13 L 4,10.5 Z M 12,12 L 19.5,15.2 L 12,22 L 4.5,15.2 Z</Geometry>
    <Geometry x:Key="IconTerminal">M4 17l6-6-6-6m8 14h8</Geometry>
    <Geometry x:Key="IconKill">M18 6L6 18M6 6l12 12</Geometry>
    <Geometry x:Key="IconCheck">M20 6L9 17l-5-5</Geometry>
    <Geometry x:Key="IconRefresh">M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15</Geometry>
    <Geometry x:Key="IconSearch">M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z</Geometry>
    <Geometry x:Key="IconClose">M18 6L6 18M6 6l12 12</Geometry>
    <Geometry x:Key="IconLineage">M7 3v18M17 9v12M3 7l4-4 4 4M13 13l4-4 4 4</Geometry>

    <!-- Navigation Rail & Action Icons -->
    <Geometry x:Key="IconNavIncidents">M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z</Geometry>
    <Geometry x:Key="IconNavInvestigation">M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m-3-3h6</Geometry>
    <Geometry x:Key="IconNavProcessGraph">M6 3v6m0 6v6m12-9v6M6 9a3 3 0 100-6 3 3 0 000 6zm0 12a3 3 0 100-6 3 3 0 000 6zm12-3a3 3 0 100-6 3 3 0 000 6zM6 9c0 3 6 3 6 6</Geometry>
    <Geometry x:Key="IconNavAttackLab">M6 22h12a1 1 0 00.86-1.51L14 11.83V5h1a1 1 0 000-2H9a1 1 0 000 2h1v6.83l-4.86 8.66A1 1 0 006 22z</Geometry>
    <Geometry x:Key="IconBack">M15 19l-7-7 7-7</Geometry>
    <Geometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</Geometry>
    <Geometry x:Key="IconExport">M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0-12l-4 4m4-4l4 4</Geometry>

    <!-- Window System Caption Icons -->
    <Geometry x:Key="IconWinMinimize">M 0,5 L 10,5</Geometry>
    <Geometry x:Key="IconWinMaximize">M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z</Geometry>
    <Geometry x:Key="IconWinRestore">M 2.5,0.5 L 9.5,0.5 L 9.5,7.5 M 0.5,2.5 L 7.5,2.5 L 7.5,9.5 L 0.5,9.5 Z</Geometry>
    <Geometry x:Key="IconWinClose">M 1,1 L 9,9 M 9,1 L 1,9</Geometry>

    <!-- ================================================================= -->
    <!--  3. Typography & Monospace Styles                                 -->
    <!-- ================================================================= -->
    <FontFamily x:Key="SansFontFamily">Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Code, Consolas, Courier New</FontFamily>

    <Style x:Key="MetricDataStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="MonospaceDataStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricDataStyle}" />

    <Style x:Key="MonospaceCodeBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Background" Value="#101010" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFontFamily}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- ================================================================= -->
    <!--  4. Enterprise Button Styles (Sharp, Compact, Professional)       -->
    <!-- ================================================================= -->
    <Style x:Key="CapsuleFilterButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CardSelectedBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderFocusedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SeverityCriticalBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SeverityCriticalTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeverityCriticalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#38181B" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SuccessActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SeverityBenignBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SeverityBenignTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeverityBenignBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1A3022" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Micro Utility Icon Button (EDR Forensic Copy / Action) -->
    <Style x:Key="UtilityCopyButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="#181818" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#262626" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#303030" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrandBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window TitleBar Caption Control Buttons (Obsidian / Win 11 Style) -->
    <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#222222" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2A2A2A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCaptionCloseButtonStyle" BasedOn="{StaticResource WindowCaptionButtonStyle}" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#B22417" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Rail Icon Button Style -->
    <Style x:Key="NavRailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E1E1E" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#282828" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!--  4. Obsidian Minimalist Expander Style for CoT / ReAct Steps      -->
    <!-- ================================================================= -->
    <Style x:Key="CoTExpanderHeaderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="HeaderBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Minimalist Chevron Vector (Linear / VS Code Style) -->
                            <Path
                                x:Name="Chevron"
                                Grid.Column="0"
                                Width="8"
                                Height="8"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 1 2.5 L 4.5 6 L 8 2.5"
                                Stretch="Uniform"
                                Stroke="{StaticResource TextMutedBrush}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Path.RenderTransform>
                            </Path>

                            <ContentPresenter
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="#171717" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="3,3,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="#1F1F1F" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoTExpanderStyle" TargetType="Expander">
        <Setter Property="Background" Value="#141414" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border
                        x:Name="CardBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <DockPanel>
                            <!-- Header ToggleButton -->
                            <ToggleButton
                                x:Name="HeaderSite"
                                DockPanel.Dock="Top"
                                Style="{StaticResource CoTExpanderHeaderToggleStyle}"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <!-- Expandable Content Site with Top Divider -->
                            <Border
                                x:Name="ContentSite"
                                DockPanel.Dock="Bottom"
                                Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Background="#0D0D0D"
                                CornerRadius="0,0,3,3"
                                Padding="14,12,14,14">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= -->
    <!--  5. Obsidian Minimalist Dark ScrollBar                            -->
    <!-- ================================================================= -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#2E2E2E" CornerRadius="3" Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#10000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
