<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- ================================================================= -->
    <!--  1. Enterprise Color Tokens (Obsidian & Deep Slate Palette)       -->
    <!-- ================================================================= -->
    <SolidColorBrush x:Key="RootBackgroundBrush" Color="#0B0D12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#13161F" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1E29" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#222836" />
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#262D3D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#282E3E" />
    <SolidColorBrush x:Key="BorderFocusedBrush" Color="#3B82F6" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

    <!-- Semantic Severity Brushes -->
    <SolidColorBrush x:Key="SeverityCriticalBgBrush" Color="#2D1418" />
    <SolidColorBrush x:Key="SeverityCriticalBorderBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="SeverityCriticalTextBrush" Color="#FCA5A5" />

    <SolidColorBrush x:Key="SeverityBenignBgBrush" Color="#13261D" />
    <SolidColorBrush x:Key="SeverityBenignBorderBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SeverityBenignTextBrush" Color="#86EFAC" />

    <SolidColorBrush x:Key="SeveritySuspendedBgBrush" Color="#2A2012" />
    <SolidColorBrush x:Key="SeveritySuspendedBorderBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SeveritySuspendedTextBrush" Color="#FDE68A" />

    <SolidColorBrush x:Key="SeverityReflexBgBrush" Color="#141E33" />
    <SolidColorBrush x:Key="SeverityReflexBorderBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="SeverityReflexTextBrush" Color="#93C5FD" />

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#2563EB" />

    <!-- ================================================================= -->
    <!--  2. Vector Icon Geometries (SVG Path Data - No Emojis)            -->
    <!-- ================================================================= -->
    <Geometry x:Key="IconShield">M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z</Geometry>
    <Geometry x:Key="IconTerminal">M4 17l6-6-6-6m8 14h8</Geometry>
    <Geometry x:Key="IconKill">M18 6L6 18M6 6l12 12</Geometry>
    <Geometry x:Key="IconCheck">M20 6L9 17l-5-5</Geometry>
    <Geometry x:Key="IconRefresh">M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15</Geometry>
    <Geometry x:Key="IconSearch">M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z</Geometry>
    <Geometry x:Key="IconClose">M18 6L6 18M6 6l12 12</Geometry>
    <Geometry x:Key="IconLineage">M7 3v18M17 9v12M3 7l4-4 4 4M13 13l4-4 4 4</Geometry>

    <!-- ================================================================= -->
    <!--  3. Typography & Monospace Styles                                 -->
    <!-- ================================================================= -->
    <Style x:Key="MonospaceDataStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="MonospaceCodeBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="#10131A" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- ================================================================= -->
    <!--  4. Enterprise Button Styles                                      -->
    <!-- ================================================================= -->
    <Style x:Key="CapsuleFilterButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#171A24" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderFocusedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource CardSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SeverityCriticalBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SeverityCriticalTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeverityCriticalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#4C1D24" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SuccessActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SeverityBenignBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SeverityBenignTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeverityBenignBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1C3D2B" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Dark ScrollBar -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#2B3245" CornerRadius="4" Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
