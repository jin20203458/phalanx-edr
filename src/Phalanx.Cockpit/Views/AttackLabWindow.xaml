<Window
    x:Class="Phalanx.Cockpit.Views.AttackLabWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Phalanx.Cockpit.Helpers"
    xmlns:vm="clr-namespace:Phalanx.Cockpit.ViewModels"
    Title="Phalanx Attack Simulator Lab"
    Width="1060"
    Height="680"
    MinWidth="880"
    MinHeight="520"
    FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="{StaticResource RootBackgroundBrush}"
    Foreground="{StaticResource TextPrimaryBrush}"
    Icon="/Assets/phalanx.ico"
    WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="42"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/EnterpriseTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource RootBackgroundBrush}">
        <Grid.RowDefinitions>
            <!--  0: Title Bar  -->
            <RowDefinition Height="42" />
            <!--  1: Content Area  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom Dark Title Bar  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="14"
                        Height="14"
                        Margin="0,0,10,0"
                        Data="{StaticResource IconNavAttackLab}"
                        Fill="{StaticResource AccentBrandBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="PHALANX ATTACK LAB" />
                    <Border
                        Margin="10,0,10,0"
                        Padding="6,2"
                        Background="#1A1A1A"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="COMPANION TOOL" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="• 7대 실무 공격 시나리오 실시간 주입 &amp; 메인 관제 콘솔 실시간 검증" />
                </StackPanel>

                <!--  Window Controls & Topmost Pin  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Margin="0,0,8,0"
                        Padding="8,3"
                        Click="ToggleTopmost_Click"
                        Content="PIN (항상 위 고정)"
                        FontSize="10.5"
                        Style="{StaticResource CapsuleFilterButtonStyle}" />
                    <Button
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="최소화">
                        <Path
                            Width="10"
                            Height="1"
                            Data="{StaticResource IconWinMinimize}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        Click="MaximizeButton_Click"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="최대화 / 복원">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconWinMaximize}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCaptionCloseButtonStyle}"
                        ToolTip="닫기">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconWinClose}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content Area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--  Left: 7 Scenario Cards List  -->
                <ColumnDefinition Width="*" MinWidth="460" />
                <!--  Right: Real-time Execution Terminal  -->
                <ColumnDefinition Width="420" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!--  Left: Scenario Cards  -->
            <ScrollViewer
                Grid.Column="0"
                Padding="18,14"
                Background="{StaticResource SurfaceBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="7대 실무 공격 및 정상 시연 시나리오 레지스트리" />

                    <ItemsControl ItemsSource="{Binding Scenarios}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttackScenarioItem}">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14,12"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  Header: Scenario ID, Name, Expected Action  -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Border
                                                    Margin="0,0,8,0"
                                                    Padding="6,2"
                                                    Background="#101010"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2">
                                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Id, StringFormat='SCENARIO {0}'}" />
                                                </Border>
                                                <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="1"
                                                Padding="6,2"
                                                Background="#181818"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ExpectedAction, StringFormat='기대 처분: {0}'}" />
                                            </Border>
                                        </Grid>

                                        <!--  Description  -->
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,0,0,10"
                                            FontSize="11.5"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            LineHeight="16"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />

                                        <!--  Action Button  -->
                                        <Button
                                            Grid.Row="2"
                                            HorizontalAlignment="Left"
                                            Padding="14,5"
                                            Command="{Binding DataContext.RunScenarioCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            Content="모의 침해 주입 (Inject Attack)"
                                            Style="{StaticResource DangerActionButtonStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  Right: Terminal Output & Quick Navigation  -->
            <Border
                Grid.Column="1"
                Padding="16,14"
                Background="{StaticResource RootBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Text="실시간 방어 검증 터미널 (DEFENSE AUDIT LOG)" />

                    <TextBox
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        Style="{StaticResource MonospaceCodeBoxStyle}"
                        Text="{Binding SimulatorLog}" />

                    <!--  Bottom Navigation Prompt  -->
                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="메인 관제 화면 실시간 연동" />
                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="주입 후 메인 콘솔에서 사건 카드와 AI 수사 과정을 확인하십시오." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="12,6"
                                Command="{Binding ReturnToIncidentsCommand}"
                                Content="관제 콘솔로 이동 ➔"
                                Style="{StaticResource CapsuleFilterButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
