<Window
    x:Class="Phalanx.Cockpit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:Phalanx.Cockpit.Helpers"
    xmlns:views="clr-namespace:Phalanx.Cockpit.Views"
    xmlns:vm="clr-namespace:Phalanx.Cockpit.ViewModels"
    Title="Phalanx EDR Cockpit"
    Width="1440"
    Height="900"
    MinWidth="1100"
    MinHeight="700"
    FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="{DynamicResource RootBackgroundBrush}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    Icon="/Assets/phalanx.ico"
    WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>


    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <!--  0: Global Top Unified Title Bar (48px)  -->
            <RowDefinition Height="48" />
            <!--  1: Multi-View Workspace (Nav Rail + Content)  -->
            <RowDefinition Height="*" />
            <!--  2: Bottom Global Telemetry Status Bar (26px)  -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!--  =============================================================  -->
        <!--  Row 0: Global Top Navigation Bar (Unified Title Bar)           -->
        <!--  =============================================================  -->
        <Border
            Grid.Row="0"
            Padding="16,0,0,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Brand / Logo (Drag Caption Area)  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Path
                        Width="16"
                        Height="16"
                        Margin="0,0,10,0"
                        Data="{StaticResource IconShield}"
                        Fill="{DynamicResource AccentBrandBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="PHALANX EDR" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Normal"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="Enterprise Threat Cockpit" />
                </StackPanel>

                <!--  Center: Sensor Status & Live Control Toggle  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Status Dot (Live: emerald, Offline: crimson)  -->
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DotCriticalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource DotLiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="SENSOR IPC 127.0.0.1:50051 " />
                    <TextBlock
                        Margin="0,0,12,0"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="OFFLINE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorConnected}" Value="True">
                                        <Setter Property="Text" Value="LIVE" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  Sensor Live Toggle Button  -->
                    <Button
                        Command="{Binding ToggleSensorCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Setter Property="Padding" Value="10,3" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Style>
                        </Button.Style>
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="Bold"
                            Text="{Binding SensorToggleText}" />
                    </Button>
                </StackPanel>

                <!--  Right: Window Caption Buttons  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal">
                    <!--  Caption Minimize, Maximize/Restore, Close Buttons  -->
                    <Button
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="최소화">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconWinMinimize}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1"
                            SnapsToDevicePixels="True" />
                    </Button>
                    <Button
                        Click="MaximizeButton_Click"
                        Style="{StaticResource WindowCaptionButtonStyle}">
                        <Button.ToolTip>
                            <ToolTip Content="최대화 / 복원" />
                        </Button.ToolTip>
                        <Path
                            Width="10"
                            Height="10"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconWinMaximize}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                            <Setter Property="Data" Value="{StaticResource IconWinRestore}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCaptionCloseButtonStyle}"
                        ToolTip="닫기">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconWinClose}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  =============================================================  -->
        <!--  Row 1: Multi-View Workspace (52px Left Rail + Content)         -->
        <!--  =============================================================  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--  Column 0: 52px Slim Navigation Rail  -->
                <ColumnDefinition Width="52" />
                <!--  Column 1: Active Dedicated View Content  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  =========================================================  -->
            <!--  Left Navigation Rail (Linear / Obsidian Style)            -->
            <!--  =========================================================  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <!--  Top Primary Nav: 2 Core Workspaces  -->
                    <StackPanel VerticalAlignment="Top" Margin="0,6">
                        <!--  Button 1: Incidents View  -->
                        <Button
                            Command="{Binding SwitchViewCommand}"
                            CommandParameter="Incidents"
                            Style="{StaticResource NavRailButtonStyle}"
                            ToolTip="사건 관제실 (Threats &amp; Incidents)">
                            <Path
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconNavIncidents}"
                                Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Incidents">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrandBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Investigation">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrandBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!--  Button 2: Process Tree DAG  -->
                        <Button
                            Command="{Binding SwitchViewCommand}"
                            CommandParameter="ProcessGraph"
                            Style="{StaticResource NavRailButtonStyle}"
                            ToolTip="인메모리 프로세스 맵 (Process Tree DAG)">
                            <Path
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconNavProcessGraph}"
                                Stroke="{Binding Path=Fill, RelativeSource={RelativeSource Self}}"
                                StrokeThickness="1"
                                Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="ProcessGraph">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrandBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>

                    <!--  Bottom Companion Launchers: Attack Lab & Settings Window  -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,6">
                        <Button
                            Command="{Binding OpenAttackLabCommand}"
                            Style="{StaticResource NavRailButtonStyle}"
                            ToolTip="모의 침해 시뮬레이터 랩 팝업 (Launch Attack Lab Companion)">
                            <Path
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconNavAttackLab}"
                                Fill="{DynamicResource TextMutedBrush}"
                                Stretch="Uniform" />
                        </Button>
                        <Button
                            Margin="0,4,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource NavRailButtonStyle}"
                            ToolTip="환경 설정 (Settings &amp; Configuration)">
                            <Path
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconNavSettings}"
                                Fill="{DynamicResource TextMutedBrush}"
                                Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  =========================================================  -->
            <!--  Main Content Area: Core Operational Views Switcher         -->
            <!--  =========================================================  -->
            <Grid Grid.Column="1">
                <!--  View 1: Incidents & Quick Triage  -->
                <views:IncidentsView>
                    <views:IncidentsView.Style>
                        <Style TargetType="views:IncidentsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Incidents">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:IncidentsView.Style>
                </views:IncidentsView>

                <!--  View 2: Dedicated Deep Dive Investigation Room  -->
                <views:InvestigationView>
                    <views:InvestigationView.Style>
                        <Style TargetType="views:InvestigationView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Investigation">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:InvestigationView.Style>
                </views:InvestigationView>

                <!--  View 3: Process Tree DAG Explorer  -->
                <views:ProcessGraphView>
                    <views:ProcessGraphView.Style>
                        <Style TargetType="views:ProcessGraphView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="ProcessGraph">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ProcessGraphView.Style>
                </views:ProcessGraphView>
            </Grid>
        </Grid>

        <!--  =============================================================  -->
        <!--  Row 2: Subtle Bottom Global Status Bar (26px)                  -->
        <!--  =============================================================  -->
        <Border
            Grid.Row="2"
            Padding="14,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left Telemetry Counters  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="MONITORED: " />
                    <TextBlock Margin="0,0,12,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding MonitoredProcessCount}" />

                    <Ellipse Width="4" Height="4" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource DotSuspendedBrush}" />
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="FROZEN: " />
                    <TextBlock Margin="0,0,12,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ActiveSuspendedCount}" />

                    <Ellipse Width="4" Height="4" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource DotCriticalBrush}" />
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="TERMINATED: " />
                    <TextBlock Margin="0,0,12,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding TotalTerminatedCount}" />

                    <Ellipse Width="4" Height="4" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource DotBenignBrush}" />
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Text="RESTORED: " />
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ActiveRestoredCount}" />
                </StackPanel>

                <!--  Right SLA Engine State  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="10"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="SAFETY WATCHDOG: 10s SLA (+50s EXTEND TICKETS) • REAC HUNTER: READY" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
