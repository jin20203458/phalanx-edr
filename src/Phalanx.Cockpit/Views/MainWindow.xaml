<Window
    x:Class="Phalanx.Cockpit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Phalanx.Cockpit.ViewModels"
    Title="PHALANX EDR // Autonomous Threat Hunter Cockpit"
    Width="1440"
    Height="900"
    MinWidth="1100"
    MinHeight="700"
    Background="#0B0D12"
    Foreground="#F1F5F9"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/EnterpriseTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Global Top Navigation Bar -->
            <RowDefinition Height="54" />
            <!-- 1: Telemetry Metrics & Filter Bar -->
            <RowDefinition Height="46" />
            <!-- 2: Main Workspace (Worklist + Inspector) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- Row 0: Global Top Navigation Bar                              -->
        <!-- ============================================================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconShield}" Fill="{StaticResource AccentBlueBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="PHALANX EDR" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" // ENTERPRISE THREAT COCKPIT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Center: Sensor Status & Live Control Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Status Dot (Green or Red) -->
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorConnected}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="SENSOR IPC : 127.0.0.1:50051 " FontSize="11" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Margin="0,0,14,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="[DISCONNECTED]" />
                                <Setter Property="Foreground" Value="#EF4444" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorConnected}" Value="True">
                                        <Setter Property="Text" Value="[CONNECTED]" />
                                        <Setter Property="Foreground" Value="#22C55E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Sensor Live Toggle Button -->
                    <Button Command="{Binding ToggleSensorCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CapsuleFilterButtonStyle}">
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#93C5FD" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SensorConnected}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="Foreground" Value="#FCA5A5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SensorToggleText}" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Refresh & Utilities -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CapsuleFilterButtonStyle}" Command="{Binding RefreshFromDbCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="REFRESH DB" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- Row 1: Telemetry Metrics & Filter Bar                         -->
        <!-- ============================================================= -->
        <Border Grid.Row="1" Background="#0F121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Metrics Counter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MONITORED: " Style="{StaticResource MonospaceDataStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MonitoredProcessCount}" Style="{StaticResource MonospaceDataStyle}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />

                    <TextBlock Text="FROZEN: " Style="{StaticResource MonospaceDataStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ActiveSuspendedCount}" Style="{StaticResource MonospaceDataStyle}" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,16,0" />

                    <TextBlock Text="TERMINATED: " Style="{StaticResource MonospaceDataStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalTerminatedCount}" Style="{StaticResource MonospaceDataStyle}" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,0,16,0" />

                    <TextBlock Text="RESTORED: " Style="{StaticResource MonospaceDataStyle}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalRestoredCount}" Style="{StaticResource MonospaceDataStyle}" FontWeight="Bold" Foreground="#86EFAC" />
                </StackPanel>

                <!-- Filters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FILTER:" Style="{StaticResource MonospaceDataStyle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource CapsuleFilterButtonStyle}" Content="ALL" Command="{Binding SetFilterCommand}" CommandParameter="ALL" Margin="0,0,4,0" />
                    <Button Style="{StaticResource CapsuleFilterButtonStyle}" Content="CRITICAL" Command="{Binding SetFilterCommand}" CommandParameter="CRITICAL" Margin="0,0,4,0" />
                    <Button Style="{StaticResource CapsuleFilterButtonStyle}" Content="BENIGN" Command="{Binding SetFilterCommand}" CommandParameter="BENIGN" Margin="0,0,4,0" />
                    <Button Style="{StaticResource CapsuleFilterButtonStyle}" Content="SUSPENDED" Command="{Binding SetFilterCommand}" CommandParameter="SUSPENDED" Margin="0,0,12,0" />

                    <!-- Search Input -->
                    <Border Background="#161922" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Width="180" Height="28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="11" VerticalAlignment="Center" FontFamily="Segoe UI" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- Row 2: Main Workspace (Worklist + Detail Inspector)           -->
        <!-- ============================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Worklist Column -->
                <ColumnDefinition Width="*" MinWidth="480" />
                <!-- Splitter -->
                <ColumnDefinition Width="4" />
                <!-- Detail Inspector Column -->
                <ColumnDefinition Width="1.3*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- Left: Incident Worklist -->
            <Border Grid.Column="0" Background="{StaticResource RootBackgroundBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SECURITY INCIDENT WORKLIST" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox
                            ItemsSource="{Binding FilteredIncidents}"
                            SelectedItem="{Binding SelectedIncident}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:IncidentItemViewModel}">
                                    <Border
                                        x:Name="cardBorder"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14"
                                        Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Card Header: Severity Badge + Time + Confidence -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Verdict Severity Badge -->
                                                <Border
                                                    Grid.Column="0"
                                                    CornerRadius="3"
                                                    BorderThickness="1"
                                                    Padding="6,2"
                                                    Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource SeveritySuspendedBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource SeveritySuspendedBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusSeverity}" Value="CRITICAL">
                                                                    <Setter Property="Background" Value="{StaticResource SeverityCriticalBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SeverityCriticalBorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusSeverity}" Value="BENIGN">
                                                                    <Setter Property="Background" Value="{StaticResource SeverityBenignBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SeverityBenignBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding VerdictAction}" FontSize="10" FontWeight="Bold" FontFamily="Cascadia Code, Consolas">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource SeveritySuspendedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusSeverity}" Value="CRITICAL">
                                                                        <Setter Property="Foreground" Value="{StaticResource SeverityCriticalTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusSeverity}" Value="BENIGN">
                                                                        <Setter Property="Foreground" Value="{StaticResource SeverityBenignTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Target Process & PID -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TargetImage}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text=" (PID: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontFamily="Cascadia Code, Consolas" />
                                                    <TextBlock Text="{Binding TargetPid}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Cascadia Code, Consolas" />
                                                    <TextBlock Text=")" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontFamily="Cascadia Code, Consolas" />
                                                </StackPanel>

                                                <!-- Timestamp & Latency -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Card Body: 1-line Summary Title -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{Binding SummaryTitle}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                FontSize="12"
                                                Margin="0,8,0,6"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- Card Footer: Lineage Breadcrumb & Confidence -->
                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="PARENT: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding ParentImage}" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />

                                                    <TextBlock Text="CONFIDENCE: " FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding ConfidenceDisplay}" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding FormattedLatency}" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextMutedBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource CardSelectedBrush}" />
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource BorderFocusedBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="#4B5568" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#1B202D" ResizeBehavior="PreviousAndNext" />

            <!-- Right: Detailed Forensic Inspector (Progressive Disclosure) -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <!-- If No Incident Selected -->
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIncident}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconTerminal}" Fill="#2B3245" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="NO INCIDENT SELECTED" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Select an event from the incident worklist to inspect forensic artifacts and ReAct trace logs." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>

                    <!-- When Incident Selected -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIncident}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Inspector Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FORENSIC INVESTIGATION AUDIT INSPECTOR" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SelectedIncident.IncidentId}" FontSize="18" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SelectedIncident.FormattedTime}" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource CapsuleFilterButtonStyle}" Command="{Binding CloseInspectorCommand}" VerticalAlignment="Top">
                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <!-- Metric Summary Tiles -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Tile 1: Verdict -->
                                <Border Grid.Column="0" Background="#181C26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="VERDICT" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedIncident.VerdictAction}" FontSize="13" FontWeight="Bold" FontFamily="Cascadia Code, Consolas">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SeveritySuspendedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedIncident.StatusSeverity}" Value="CRITICAL">
                                                            <Setter Property="Foreground" Value="{StaticResource SeverityCriticalTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedIncident.StatusSeverity}" Value="BENIGN">
                                                            <Setter Property="Foreground" Value="{StaticResource SeverityBenignTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Tile 2: Confidence -->
                                <Border Grid.Column="1" Background="#181C26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="CONFIDENCE" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedIncident.ConfidenceDisplay}" FontSize="13" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Tile 3: Latency / Budget -->
                                <Border Grid.Column="2" Background="#181C26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="LATENCY" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedIncident.FormattedLatency}" FontSize="13" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Section: Executive Summary -->
                            <TextBlock Text="EXECUTIVE SUMMARY" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Background="#161923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedIncident.SummaryTitle}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding SelectedIncident.Narrative}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Section: Process Execution Context (CLI) -->
                            <TextBlock Text="EXECUTION CONTEXT &amp; COMMAND LINE" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox Text="{Binding SelectedIncident.CommandLine}" Style="{StaticResource MonospaceCodeBoxStyle}" Height="64" Margin="0,0,0,16" />

                            <!-- Section: ReAct Audit Trail -->
                            <TextBlock Text="AUTONOMOUS RE-ACT INVESTIGATION AUDIT TRAIL" Style="{StaticResource SectionHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding SelectedIncident.Traces}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReActStepViewModel}">
                                        <Border Background="#161A24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- Phase Header -->
                                                <TextBlock Text="{Binding FormattedStep}" FontWeight="Bold" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,6" />

                                                <!-- Investigator Hypothesis (Thought) -->
                                                <TextBlock Text="INVESTIGATOR HYPOTHESIS [THOUGHT]:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,2" />
                                                <TextBlock Text="{Binding Thought}" FontSize="12" Foreground="#CBD5E1" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                <!-- Tool Arguments -->
                                                <TextBlock Text="ACTION ARGUMENTS [JSON]:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,2" />
                                                <TextBox Text="{Binding ActionArgsJson}" Style="{StaticResource MonospaceCodeBoxStyle}" MaxHeight="45" Margin="0,0,0,8" />

                                                <!-- Forensic Observation -->
                                                <TextBlock Text="FORENSIC OBSERVATION EVIDENCE:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,2" />
                                                <TextBox Text="{Binding Observation}" Style="{StaticResource MonospaceCodeBoxStyle}" MaxHeight="60" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Section: Remediation Runbook -->
                            <TextBlock Text="REMEDIATION PRESCRIPTION RUNBOOK" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Background="#161923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding SelectedIncident.RemediationSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="• " Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontFamily="Segoe UI" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Section: Manual SecOps Override Controls -->
                            <TextBlock Text="SECOPS MANUAL OVERRIDE CONTROLS" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                                <Button Style="{StaticResource DangerActionButtonStyle}" Command="{Binding ForceTerminateCommand}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconKill}" Fill="{StaticResource SeverityCriticalTextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                        <TextBlock Text="FORCE TERMINATE" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SuccessActionButtonStyle}" Command="{Binding ForceResumeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SeverityBenignTextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                        <TextBlock Text="FORCE RESUME" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
