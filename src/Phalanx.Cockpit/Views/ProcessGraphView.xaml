<UserControl
    x:Class="Phalanx.Cockpit.Views.ProcessGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cqrs="clr-namespace:Phalanx.Cockpit.CQRS"
    xmlns:views="clr-namespace:Phalanx.Cockpit.Views"
    xmlns:vm="clr-namespace:Phalanx.Cockpit.ViewModels"
    FontFamily="{StaticResource SansFontFamily}"
    Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Background="{DynamicResource RootBackgroundBrush}">
        <Grid.RowDefinitions>
            <!--  0: Top Header  -->
            <RowDefinition Height="50" />
            <!--  1: Tree & Inspector  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Header  -->
        <Border
            Grid.Row="0"
            Padding="16,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Path
                        Width="16"
                        Height="16"
                        Margin="0,0,10,0"
                        Data="{StaticResource IconNavProcessGraph}"
                        Fill="{DynamicResource AccentBrandBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="프로세스 트리 탐색기 (PROCESS TREE DAG)" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="{Binding MonitoredProcessCount, StringFormat='활성 프로세스: {0}개'}" />
                    <CheckBox
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Content="종료된 프로세스 숨기기"
                        IsChecked="{Binding HideTerminatedProcesses, Mode=TwoWay}"
                        ToolTip="이미 종료된 프로세스를 트리에서 감추고 현재 활성 프로세스만 표시합니다" />
                    <CheckBox
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Content="선택 항목 화면 고정"
                        IsChecked="{Binding IsSelectionPinned, Mode=TwoWay}"
                        ToolTip="실시간 프로세스 갱신 시에도 현재 선택된 프로세스가 화면에 유지되도록 스크롤을 고정합니다" />
                    <Button
                        Padding="10,4"
                        Command="{Binding RefreshProcessTreeCommand}"
                        Content="새로고침"
                        Style="{StaticResource CapsuleFilterButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Tree & Inspector Split  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Left: Hierarchical Process TreeView  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <ListView
                    x:Name="ProcessListView"
                    Padding="4,8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding VisibleProcesses}"
                    SelectedItem="{Binding SelectedProcessNode, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    VirtualizingStackPanel.ScrollUnit="Pixel"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border
                                            x:Name="Bd"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type cqrs:ProcessNodeModel}">
                            <Grid Margin="{Binding IndentMargin}">
                                <Grid.ColumnDefinitions>
                                    <!--  0: Chevron expander button (18px)  -->
                                    <ColumnDefinition Width="18" />
                                    <!--  1: Live dot, Process name, PID, Status  -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Expander Toggle Button  -->
                                <Button
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=views:ProcessGraphView}}"
                                    CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path
                                        x:Name="ExpandChevron"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource TextMutedBrush}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="M 0 0 L 4 4 L 8 0 Z" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90" CenterX="4" CenterY="2" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <!--  Process Info  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="5"
                                        Height="5"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource DotLiveBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource DotBenignBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource DotSuspendedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTerminated}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource DotCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding ImageName}"
                                        ToolTip="{Binding FullImagePath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlive}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding ProcessId, StringFormat='(PID: {0})'}" />

                                    <!--  Suspended / Terminated Badges  -->
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        FontSize="10"
                                        FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Text" Value="" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Text" Value="[동결]" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SeveritySuspendedTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTerminated}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Text" Value="[사살]" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SeverityCriticalTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!--  Right: Selected Process Details & Direct Actuation  -->
            <Border
                Grid.Column="1"
                Padding="16"
                Background="{DynamicResource RootBackgroundBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="선택된 프로세스 정보 (PROCESS INSPECTOR)" />

                    <!--  Placeholder when no process is selected  -->
                    <Border
                        Margin="0,0,0,16"
                        Padding="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessNode}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock
                                FontSize="13.5"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Text="프로세스를 선택하십시오" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="좌측 트리에서 프로세스 노드를 클릭하면 상세 계통과 명령줄, AI 수사 기록이 표시됩니다." />
                        </StackPanel>
                    </Border>

                    <!--  Dynamic Node Details when Selected  -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProcessNode}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!--  Node Identification Card  -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="14"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Text="{Binding SelectedProcessNode.ImageName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SelectedProcessNode.FullImagePath}" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="6,2"
                                        Background="{DynamicResource BadgeBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Text="{Binding SelectedProcessNode.Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProcessNode.IsTerminated}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SeverityCriticalTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProcessNode.IsSuspended}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SeveritySuspendedTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProcessNode.IsRestored}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SeverityBenignTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="PID:" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SelectedProcessNode.ProcessId}" />
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="부모 PID (PPID):" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SelectedProcessNode.ParentProcessId}" />
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="세션 ID (Session):" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedProcessNode.SessionId}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="관리자 권한 수준:" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Medium (일반)" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProcessNode.TokenElevationType}" Value="2">
                                                        <Setter Property="Text" Value="High (관리자 UAC)" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DotCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedProcessNode.TokenElevationType}" Value="3">
                                                        <Setter Property="Text" Value="Low (격리)" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Command Line Context  -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="실행 명령줄 (COMMAND LINE)" />
                        <TextBox
                            Height="56"
                            Margin="0,0,0,12"
                            Style="{StaticResource MonospaceCodeBoxStyle}"
                            Text="{Binding SelectedProcessNode.CommandLine}" />

                        <!--  Incident Link Banner (If this process has an incident)  -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="{DynamicResource SeverityCriticalBgBrush}"
                            BorderBrush="{DynamicResource DotCriticalBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasIncidentForSelectedProcess}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DotCriticalBrush}" Text="보안 침해 사고 및 AI 수사 기록 존재" />
                                    <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedProcessIncident.SummaryTitle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="10,5"
                                    Command="{Binding OpenInvestigationForProcessCommand}"
                                    CommandParameter="{Binding SelectedProcessNode.ProcessId}"
                                    Content="AI 수사 기록 열기 ➔"
                                    Style="{StaticResource CapsuleFilterButtonStyle}" />
                            </Grid>
                        </Border>

                        <!--  Manual Actuation Commands (Direct Intervention)  -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="원자적 프로세스 제어 (MANUAL ACTUATION)" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Suspend <-> Resume Dynamic Toggle -->
                            <Grid Grid.Column="0">
                                <!-- Button 1: 원자적 동결 (IsSuspended == False 일 때 표시) -->
                                <Button
                                    Padding="8,6"
                                    Command="{Binding SuspendSelectedProcessCommand}"
                                    Content="원자적 동결 (Suspend)">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="ToolTip" Value="NtSuspendProcess 시스템 콜을 통해 프로세스를 즉각 동결합니다 (24μs)" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsSuspended}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsAlive}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsTerminated}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsInvestigating}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="AI 심층 수사가 진행 중입니다. (수사 완료 또는 취소 후 수동 제어 가능)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Button 2: 동결 해제 (IsSuspended == True 일 때 표시) -->
                                <Button
                                    Padding="8,6"
                                    Command="{Binding ResumeSelectedProcessCommand}"
                                    Content="동결 해제 (Resume)">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="ToolTip" Value="NtResumeProcess 시스템 콜을 통해 프로세스 실행을 즉각 재개합니다" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsSuspended}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsAlive}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsTerminated}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProcessNode.IsInvestigating}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="AI 심층 수사가 진행 중입니다. (수사 완료 또는 취소 후 수동 제어 가능)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Column 2: 프로세스 사살 (Kill) -->
                            <Button
                                Grid.Column="2"
                                Padding="8,6"
                                Command="{Binding TerminateSelectedProcessCommand}"
                                Content="프로세스 사살 (Kill)">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource DangerActionButtonStyle}" TargetType="Button">
                                        <Setter Property="ToolTip" Value="NtTerminateProcess 시스템 콜을 통해 프로세스를 강제 종료합니다" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProcessNode.IsAlive}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip" Value="이미 종료되었거나 사살된 프로세스입니다." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProcessNode.IsTerminated}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip" Value="이미 현장 사살된 프로세스입니다." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedProcessNode.IsInvestigating}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip" Value="AI 심층 수사가 진행 중입니다. (수사 완료 또는 취소 후 수동 제어 가능)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
