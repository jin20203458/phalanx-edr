<Window
    x:Class="Phalanx.Cockpit.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="clr-namespace:Phalanx.Cockpit.Helpers"
    xmlns:viewmodels="clr-namespace:Phalanx.Cockpit.ViewModels"
    Title="Phalanx EDR - 환경 설정"
    Width="820"
    Height="600"
    MinWidth="740"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    AllowsTransparency="False"
    Background="{DynamicResource RootBackgroundBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="1"
    FontFamily="{StaticResource SansFontFamily}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    MouseDown="Window_MouseDown"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="38"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="4"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource RootBackgroundBrush}">
        <Grid.RowDefinitions>
            <!--  Row 0: Top Window Caption Header (38px)  -->
            <RowDefinition Height="38" />
            <!--  Row 1: Main Category Sidebar & Settings Panels (*)  -->
            <RowDefinition Height="*" />
            <!--  Row 2: Bottom Status & Actions Toolbar (48px)  -->
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <!--  =============================================================  -->
        <!--  Row 0: Sleek Custom Caption Bar                                -->
        <!--  =============================================================  -->
        <Border
            Grid.Row="0"
            Padding="14,0,8,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left Title & Badge  -->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Path
                        Width="13"
                        Height="13"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconNavSettings}"
                        Fill="{DynamicResource TextSecondaryBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="PHALANX EDR" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BadgeBgBrush}"
                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                        <TextBlock
                            FontSize="9.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="환경 설정 (SETTINGS)" />
                    </Border>
                </StackPanel>

                <!--  Right Caption Buttons  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Click="MinimizeButton_Click"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="최소화">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconWinMinimize}"
                            SnapsToDevicePixels="True"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        Click="CloseButton_Click"
                        Style="{StaticResource WindowCaptionCloseButtonStyle}"
                        ToolTip="닫기">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconWinClose}"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  =============================================================  -->
        <!--  Row 1: Category Sidebar (Left) + Detail Form (Right)           -->
        <!--  =============================================================  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--  Left Categories (180px)  -->
                <ColumnDefinition Width="180" />
                <!--  Right Settings Workspace (*)  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar Navigation  -->
            <Border
                Grid.Column="0"
                Padding="8,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock
                        Margin="8,0,0,8"
                        FontSize="9.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="설정 카테고리" />

                    <!--  Tab 1: AI Hunter & LLM  -->
                    <Button
                        Margin="0,0,0,4"
                        Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="AI"
                        FontSize="11">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoryAi}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AI 수사관 (Gemini)" />
                        </StackPanel>
                    </Button>

                    <!--  Tab 2: Kernel & Sensor IPC  -->
                    <Button
                        Margin="0,0,0,4"
                        Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="SENSOR"
                        FontSize="11">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategorySensor}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="커널 센서 (IPC)" />
                        </StackPanel>
                    </Button>

                    <!--  Tab 3: Storage & DB  -->
                    <Button
                        Margin="0,0,0,4"
                        Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="STORAGE"
                        FontSize="11">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoryStorage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="포렌식 스토리지" />
                        </StackPanel>
                    </Button>

                    <!--  Tab 4: UI Theme & Appearance  -->
                    <Button
                        Margin="0,0,0,4"
                        Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="THEME"
                        FontSize="11">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoryTheme}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="외형 및 테마" />
                        </StackPanel>
                    </Button>

                    <!--  Tab 5: System Info  -->
                    <Button
                        Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding SelectCategoryCommand}"
                        CommandParameter="INFO"
                        FontSize="11">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoryInfo}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="시스템 정보" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Right Setting Content Pages  -->
            <ScrollViewer
                Grid.Column="1"
                Padding="20,16"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!--  =====================================================  -->
                    <!--  PAGE 1: AI Hunter & LLM Configuration                  -->
                    <!--  =====================================================  -->
                    <StackPanel Visibility="{Binding IsCategoryAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!--  Section Header  -->
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="자율 AI 위협 헌터 (Autonomous Hunter Agent) 설정" />
                        <TextBlock
                            Margin="0,2,0,14"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="Google Cloud Vertex AI(엔터프라이즈) 또는 Google AI Studio(API 키)를 통한 자율 ReAct 수사 모델을 구성합니다." />

                        <!--  Cloud Auth Mode Selector  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormLabelStyle}" Text="클라우드 인증 방식:" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <RadioButton
                                        IsChecked="{Binding UseVertexAi}"
                                        Margin="0,0,16,0"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Content="Google Cloud Vertex AI (Service Account 권장)"
                                        FontSize="11" />
                                    <RadioButton
                                        IsChecked="{Binding IsApiKeyMode}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Content="Google AI Studio (API Key)"
                                        FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Vertex AI Specific Parameters  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{Binding UseVertexAi, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="Google Cloud Vertex AI 연결 파라미터" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Project ID  -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Google Cloud Project ID:" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding VertexProjectId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  Location  -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="리전 (Location, 기본 global):" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding VertexLocation, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Credentials Key File  -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Service Account 키 파일 경로 (google-credentials.json):" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FormInputStyle}" Text="{Binding CredentialsPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="2"
                                            Padding="10,4"
                                            Command="{Binding BrowseCredentialsCommand}"
                                            Content="찾아보기..."
                                            Style="{StaticResource CapsuleFilterButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <!--  Key Status Badge  -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="키 파일 검증 상태: " VerticalAlignment="Center" />
                                    <Border
                                        Padding="6,1"
                                        CornerRadius="2"
                                        Background="{DynamicResource BadgeBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="키 파일 누락 (오프라인 모드로 폴백됨)" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DotCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CredentialsFound}" Value="True">
                                                            <Setter Property="Text" Value="키 파일 확인됨 (Vertex AI 준비 완료)" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DotLiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  AI Studio API Key Mode Parameters  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{Binding IsApiKeyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="Google AI Studio API Key" />
                                <TextBlock Style="{StaticResource FormLabelStyle}" Text="Gemini API Key (AIzaSy...):" />
                                <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <!--  Model & ReAct Loop Parameters  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="모델 및 ReAct 자율 수사 정책" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Model Name  -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="대상 모델 (Model Name):" />
                                        <ComboBox
                                            ItemsSource="{Binding AvailableModels}"
                                            SelectedItem="{Binding SelectedModel}" />
                                    </StackPanel>

                                    <!--  Max Steps  -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="최대 ReAct 수사 턴 수 (MaxSteps, 1~10):" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding MaxSteps, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  CtsTimeoutSec  -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="AI 수사 만료 및 동결 연장 시한 (CtsTimeoutSec, 10~120초):" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding CtsTimeoutSec, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!--  WatchdogTimeoutSec  -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="커널 초기 안전 워치독 (WatchdogTimeoutSec, 5~30초):" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding WatchdogTimeoutSec, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <!--  Toggles  -->
                                <CheckBox
                                    IsChecked="{Binding OfflineFallbackEnabled}"
                                    Margin="0,0,0,6"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Content="네트워크 오류 또는 API 한도 초과 시 오프라인 결정론적 엔진(FSM)으로 자동 폴백" />
                                <CheckBox
                                    IsChecked="{Binding FailSecureEnabled}"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Content="최대 수사 턴 수(MaxSteps) 초과 또는 미해결 시 Fail-Secure 선제 사살 집행" />
                            </StackPanel>
                        </Border>

                        <!--  Connection Test Button & Status  -->
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Padding="12,5"
                                    Command="{Binding TestConnectionCommand}"
                                    Content="Gemini 연결 시험"
                                    Style="{StaticResource CapsuleFilterButtonStyle}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding TestStatusMessage}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--  =====================================================  -->
                    <!--  PAGE 2: Kernel Sensor & IPC Configuration              -->
                    <!--  =====================================================  -->
                    <StackPanel Visibility="{Binding IsCategorySensor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="C++ 네이티브 커널 센서 및 액추에이터 (Sensor IPC) 설정" />
                        <TextBlock
                            Margin="0,2,0,14"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="Windows Kernel ETW 텔레메트리 센서와 Cockpit 간 gRPC IPC 파라미터를 구성합니다." />

                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="gRPC IPC 통신 설정" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="센서 IPC 호스트:" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding SensorHost, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="gRPC 포트 (1024~65535, 기본 50051):" />
                                        <TextBox Style="{StaticResource FormInputStyle}" Text="{Binding SensorPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Sensor Binary & Runtime Status Card  -->
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="커널 센서 바이너리 및 런타임 상태" />

                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="탐지된 C++ 센서 바이너리 경로 (Phalanx.Sensor.exe):" />
                                    <TextBox Style="{StaticResource FormInputStyle}" IsReadOnly="True" Text="{Binding SensorBinaryPath, Mode=OneWay}" />
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Binary Integrity Badge  -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="바이너리 무결성: " VerticalAlignment="Center" />
                                        <Border
                                            Padding="6,1"
                                            CornerRadius="2"
                                            Background="{DynamicResource BadgeBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                            <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="바이너리 미검출 (빌드 필요)" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DotCriticalBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SensorBinaryFound}" Value="True">
                                                                <Setter Property="Text" Value="바이너리 확인됨 (준비 완료)" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DotLiveBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!--  Sensor Running State Badge  -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="센서 구동 상태: " VerticalAlignment="Center" />
                                        <Border
                                            Padding="6,1"
                                            CornerRadius="2"
                                            Background="{DynamicResource BadgeBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                            <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="센서 중지됨 (대기 상태)" />
                                                        <Setter Property="Foreground" Value="{DynamicResource DotSuspendedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSensorConnected}" Value="True">
                                                                <Setter Property="Text" Value="센서 구동 중 (IPC 활성)" />
                                                                <Setter Property="Foreground" Value="{DynamicResource DotLiveBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  =====================================================  -->
                    <!--  PAGE 3: Storage & Forensics Configuration              -->
                    <!--  =====================================================  -->
                    <StackPanel Visibility="{Binding IsCategoryStorage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="포렌식 아카이브 및 저장소 (Storage &amp; Archive) 설정" />
                        <TextBlock
                            Margin="0,2,0,14"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="임베디드 LiteDB 인과 데이터베이스 및 침해사고 감사 보고서 경로를 구성합니다." />

                        <!--  Card 1: Database & Export Path Configuration  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="저장소 경로 및 내보내기 설정" />

                                <!--  Database Path with Browse Button  -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="LiteDB 포렌식 데이터베이스 파일명 또는 경로:" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FormInputStyle}" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="2"
                                            Padding="10,4"
                                            Command="{Binding BrowseDatabaseCommand}"
                                            Content="찾아보기..."
                                            Style="{StaticResource CapsuleFilterButtonStyle}" />
                                    </Grid>
                                    <TextBlock Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Text="※ 데이터베이스 파일 변경은 Cockpit 재시작 시 적용됩니다." />
                                </StackPanel>

                                <!--  Report Export Path with Browse & Open Buttons  -->
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="침해 보고서 내보내기 디렉터리:" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FormInputStyle}" Text="{Binding ReportExportPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="2"
                                            Padding="10,4"
                                            Command="{Binding BrowseReportExportCommand}"
                                            Content="찾아보기..."
                                            Style="{StaticResource CapsuleFilterButtonStyle}" />
                                        <Button
                                            Grid.Column="4"
                                            Padding="10,4"
                                            Command="{Binding OpenReportFolderCommand}"
                                            Content="폴더 열기"
                                            Style="{StaticResource CapsuleFilterButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Card 2: Storage Diagnostics & Maintenance  -->
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="스토리지 무결성 및 런타임 진단" />

                                <!--  Resolved DB Absolute Path  -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="물리적 데이터베이스 실제 파일 경로:" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource FormInputStyle}" IsReadOnly="True" Text="{Binding DatabaseResolvedPath, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            Padding="10,4"
                                            Command="{Binding OpenDatabaseFolderCommand}"
                                            Content="탐색기에서 표시"
                                            Style="{StaticResource CapsuleFilterButtonStyle}" />
                                    </Grid>
                                </StackPanel>

                                <!--  Status Badges & Maintenance Actions  -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Left: DB File Status & Size  -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="파일 상태: " VerticalAlignment="Center" />
                                            <Border
                                                Padding="6,1"
                                                CornerRadius="2"
                                                Background="{DynamicResource BadgeBgBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                                <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="신규 생성 대기" />
                                                            <Setter Property="Foreground" Value="{DynamicResource DotSuspendedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DatabaseFileExists}" Value="True">
                                                                    <Setter Property="Text" Value="DB 파일 확인됨 (정상)" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DotLiveBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="DB 용량: " />
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DatabaseFileSizeText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Right: Record Count & Clear Button  -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="보관된 침해사고:" />
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding IncidentCount, StringFormat='{}{0} 건'}" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Padding="10,4"
                                            Command="{Binding ClearIncidentsCommand}"
                                            Content="기록 초기화"
                                            Style="{StaticResource CapsuleFilterButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  =====================================================  -->
                    <!--  PAGE 4: System Information                             -->
                    <!--  =====================================================  -->
                    <StackPanel Visibility="{Binding IsCategoryInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="Phalanx EDR 시스템 정보" />
                        <TextBlock
                            Margin="0,2,0,14"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="엔터프라이즈 솔루션 사양 및 호스트 런타임 환경 정보" />

                        <!--  Card 1: Product Specifications  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="제품 및 솔루션 사양" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="솔루션 명칭:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Phalanx Autonomous EDR" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="솔루션 버전:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ProductVersionText, Mode=OneWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="라이선스 에디션:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Text="Enterprise Security Edition" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Card 2: Host Platform & Active Runtime Configuration  -->
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="호스트 플랫폼 및 활성 런타임 환경" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="호스트 운영체제:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding HostPlatformText, Mode=OneWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="실행 런타임:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding DotNetRuntimeText, Mode=OneWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="활성 AI 인지 엔진:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ActiveAiModelText, Mode=OneWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="센서 통신 엔드포인트:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding ActiveSensorEndpointText, Mode=OneWay}" />
                                        <Run Text=" (HTTP/2 gRPC)" Foreground="{DynamicResource TextMutedBrush}" />
                                    </TextBlock>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="포렌식 아카이브 DB:" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ActiveDatabaseText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  =====================================================  -->
                    <!--  PAGE 5: Theme & Appearance                             -->
                    <!--  =====================================================  -->
                    <StackPanel Visibility="{Binding IsCategoryTheme, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Text="외형 및 테마 (Theme &amp; Appearance)" />
                        <TextBlock
                            Margin="0,2,0,14"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="Phalanx Cockpit의 시각적 테마를 설정합니다. 테마 변경 시 재시작 없이 실시간으로 전체 UI가 즉각 전환됩니다." />

                        <!--  Theme Mode Selection Card  -->
                        <Border
                            Margin="0,0,0,14"
                            Padding="14"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="테마 모드 선택 (THEME MODE)" />

                                <!-- Option 1: System Sync -->
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <RadioButton
                                        GroupName="AppThemeOptions"
                                        IsChecked="{Binding IsThemeSystem, Mode=OneWay}"
                                        Command="{Binding SetThemeModeCommand}"
                                        CommandParameter="System"
                                        Cursor="Hand">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Text="시스템 설정 동기화 (System Default)" />
                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="Windows OS의 다크/라이트 테마 설정을 실시간으로 자동 감지하여 일치시킵니다." />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>

                                <!-- Option 2: Dark Mode -->
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <RadioButton
                                        GroupName="AppThemeOptions"
                                        IsChecked="{Binding IsThemeDark, Mode=OneWay}"
                                        Command="{Binding SetThemeModeCommand}"
                                        CommandParameter="Dark"
                                        Cursor="Hand">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Text="다크 모드 (Enterprise Obsidian Dark)" />
                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="눈의 피로를 최소화하는 정밀한 흑색 계열(#0E0E0E) 보안 관제 전용 테마입니다." />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>

                                <!-- Option 3: Light Mode -->
                                <Border
                                    Padding="12,10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <RadioButton
                                        GroupName="AppThemeOptions"
                                        IsChecked="{Binding IsThemeLight, Mode=OneWay}"
                                        Command="{Binding SetThemeModeCommand}"
                                        CommandParameter="Light"
                                        Cursor="Hand">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Text="라이트 모드 (Enterprise Neutral Light)" />
                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="높은 명암비와 가독성을 제공하는 모던 오프화이트(#F8FAFC) 테마입니다." />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  Live Status Info Card  -->
                        <Border
                            Padding="12,10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="현재 활성 테마 상태:" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="라이트 모드 (Light Palette)" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentThemeActuallyDark}" Value="True">
                                                    <Setter Property="Text" Value="다크 모드 (Dark Palette)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  =============================================================  -->
        <!--  Row 2: Bottom Status & Actions Toolbar                         -->
        <!--  =============================================================  -->
        <Border
            Grid.Row="2"
            Padding="16,0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left Status Message  -->
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />

                <!--  Right Action Buttons  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="12,5"
                        Command="{Binding ResetDefaultsCommand}"
                        Content="기본값 초기화"
                        FontSize="10.5"
                        Style="{StaticResource CapsuleFilterButtonStyle}" />

                    <Button
                        Margin="0,0,8,0"
                        Padding="12,5"
                        Command="{Binding CloseCommand}"
                        Content="취소"
                        FontSize="10.5"
                        Style="{StaticResource CapsuleFilterButtonStyle}" />

                    <Button
                        Padding="14,5"
                        Command="{Binding SaveSettingsCommand}"
                        Content="저장 및 적용"
                        FontSize="10.5"
                        FontWeight="Bold">
                        <Button.Style>
                            <Style BasedOn="{StaticResource CapsuleFilterButtonStyle}" TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
